{
  "name": "neardesk",
  "version": "0.1.0",
  "description": "Sovereign Edge AI Operator Desk for NEAR Protocol, Chain Signatures & TEE Cloud",
  "private": true,
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:agent": "cd apps/board-agent && python -m neardesk_agent",
    "test:api": "cd apps/api && python -m pytest tests -q",
    "emu:up": "docker compose -f apps/board-emu/docker-compose.yml up --build -d jetson-nano",
    "emu:down": "docker compose -f apps/board-emu/docker-compose.yml down",
    "emu:logs": "docker compose -f apps/board-emu/docker-compose.yml logs -f jetson-nano"
  },
  "keywords": [
    "near-protocol",
    "chain-signatures",
    "near-intents",
    "near-ai",
    "edge-computing",
    "nvidia-jetson",
    "autonomous-agents",
    "sovereign-ai"
  ],
  "author": "NearDesk Team",
  "license": "Apache-2.0"
}
