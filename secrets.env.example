# ==============================================================================
# NearDesk Environment & Secrets Configuration
# ==============================================================================
# Copy this file to `secrets.env` and fill in your credentials.
# NEVER commit `secrets.env` to Git.

# --- NEAR AI Cloud ---
# Get your API key at https://cloud.near.ai
NEARAI_API_KEY=your_near_ai_cloud_api_key_here
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=qwen/qwen3.5-397b-a17b

# --- NEAR Blockchain & Account (Testnet by default) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=your-account.testnet
NEAR_PRIVATE_KEY=ed25519:your_private_key_here

# --- NEAR Chain Signatures (MPC Multi-Chain) ---
# MPC Signer contract on NEAR
NEAR_MPC_CONTRACT_ID=v1.signer-prod.testnet

# --- NEAR Intents (1Click Swaps & Cross-chain Solver Network) ---
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_JWT=

# --- Local Edge LLM (Ollama running on Jetson / Localhost) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- NearDesk Routing & Security ---
# Options: hybrid | near_cloud | local_only
LLM_MODE=hybrid
DESK_AUTH_SECRET=neardesk_operator_secret_change_me
LOG_LEVEL=INFO
